# ==========================================
# DataLens AI Platform Environment Config
# ==========================================

# Backend API Configuration
DATABASE_URL=sqlite:///./datalens.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://datalens:datalens_secret_password_2026@postgres:5432/datalens_ai

JWT_SECRET=datalens-ai-super-secret-key-development-mode-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080
MAX_UPLOAD_SIZE_MB=100

# AI Provider API Keys (Optional - Deterministic Semantic Query Engine runs as offline fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# n8n Quantura Copilot (server-side only; never expose the secret with NEXT_PUBLIC_)
N8N_COPILOT_WEBHOOK_URL=https://abdxllxh2002.app.n8n.cloud/webhook/quantura-copilot
N8N_WEBHOOK_SECRET=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
