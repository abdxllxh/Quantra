      "id": "9e4d7322-a109-4f40-beee-5991dd997879",
      "name": "Ask Quantura Dataset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1312,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\n\nconst base = {\n  success: true,\n  intent: null,\n  answer: null,\n  grounded_data: {},\n  recommended_chart: null,\n  proposed_transformation: null,\n  confidence_score: 0.0,\n  target_section: null,\n  suggested_followups: [],\n};\n\n// Validation failure path: return an accurate, recoverable client error.\nif (item && item.valid === false) {\n  return [{ json: {\n    statusCode: item.error_status === 401 ? 401 : 400,\n    response: { success: false, error: item.validation_error ?? 'Invalid Copilot request.' },\n  } }];\n}\n\n// Dataset API path (HTTP fullResponse: has numeric statusCode).\nif (item && typeof item.statusCode === 'number') {\n  const status = item.statusCode;\n  let body = item.body ?? {};\n  if (typeof body === 'string') {\n    try { body = JSON.parse(body); } catch { body = { detail: body }; }\n  }\n  if (status >= 400) {\n    const detail = body.detail ?? body.error ?? 'The Quantura dataset service returned an error.';\n    return [{ json: { statusCode: status, response: {\n      ...base,\n      success: false,\n      intent: 'dataset_question',\n      answer: String(detail),\n      error: String(detail),\n    } } }];\n  }\n  return [{ json: { statusCode: 200, response: {\n    ...base,\n    success: true,\n    intent: 'dataset_question',\n    answer: body.answer ?? null,\n    grounded_data: body.grounded_data ?? {},\n    recommended_chart: body.recommended_chart ?? null,\n    proposed_transformation: body.proposed_transformation ?? null,\n    confidence_score: typeof body.confidence_score === 'number' ? body.confidence_score : 0.0,\n    suggested_followups: Array.isArray(body.suggested_followups) ? body.suggested_followups : [],\n  } } }];\n}\n\n// Workspace help path (agent output object).\nif (item && item.output) {\n  const o = item.output;\n  return [{ json: { statusCode: 200, response: {\n    ...base,\n    success: true,\n    intent: 'workspace_help',\n    answer: o.answer ?? null,\n    target_section: o.target_section ?? null,\n    confidence_score: typeof o.confidence_score === 'number' ? o.confidence_score : 0.0,\n    suggested_followups: Array.isArray(o.suggested_followups) ? o.suggested_followups : [],\n  } } }];\n}\n\n// Safe fallback: never fabricate data.\nreturn [{ json: { statusCode: 500, response: { ...base, success: false, error: 'Unable to process the request.', answer: 'Unable to process the request.' } } }];"
      },
