    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst headers = input.headers ?? {};\nconst body = input.body ?? {};\nconst rawAuth = headers.authorization ?? headers.Authorization ?? body.authorization;\nconst allowed = ['general', 'business', 'data_quality', 'anomaly'];\nconst errors = [];\nif (!body.dataset_id || !String(body.dataset_id).trim()) errors.push('dataset_id is required.');\nif (!String(body.question ?? '').trim()) errors.push('question is required.');\nconst context_mode = body.context_mode ?? 'general';\nif (!allowed.includes(context_mode)) errors.push('context_mode must be one of: general, business, data_quality, anomaly.');\nconst bearer = typeof rawAuth === 'string' && rawAuth.startsWith('Bearer ') ? rawAuth : null;\nif (!bearer) errors.push('A valid Authorization Bearer token is required.');\nif (errors.length) {\n  return [{ json: {\n    valid: false,\n    error_status: bearer ? 400 : 401,\n    validation_error: errors.join(' '),\n  } }];\n}\nreturn [{ json: {\n  valid: true,\n  dataset_id: String(body.dataset_id).trim(),\n  question: String(body.question).trim().slice(0, 4000),\n  privacy_mode: Boolean(body.privacy_mode),\n  context_mode,\n  authorization: bearer,\n} }];"
      },
