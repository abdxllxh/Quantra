    {
      "parameters": {
        "promptType": "define",
        "text": "=User question: {{ $json.question }}\nContext mode: {{ $json.context_mode }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an intent classifier for the Quantura Copilot.\nClassify the user question into exactly one intent:\n- \"dataset_question\": the user asks about the contents, values, statistics, quality, anomalies, or analysis of their active Quantura dataset.\n- \"workspace_help\": the user asks how to use, navigate, or find a feature inside the Quantura workspace/product.\nReturn only the classification and a confidence_score between 0 and 1.\nNever invent dataset values or answer the question here."
        }
      },
